# Postgres
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow
PGPORT=5432

# S3-compatible storage (RustFS)
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
S3_BUCKET=mlflow

# MLflow Server
MLFLOW_BACKEND_STORE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${PGPORT}/${POSTGRES_DB}
MLFLOW_ARTIFACTS_DESTINATION=s3://${S3_BUCKET}/
MLFLOW_S3_ENDPOINT_URL=http://storage:9000

# AWS region (for Boto3)
AWS_DEFAULT_REGION=us-east-1

# MLflow listen settings
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000

# MLflow version — pin it; a newer release may need `mlflow db upgrade` (see README)
MLFLOW_VERSION=v3.16.1